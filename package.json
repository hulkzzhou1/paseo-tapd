{
  "name": "tapd-workbench",
  "private": true,
  "version": "0.4.47",
  "files": [
    "LICENSE",
    "README.md",
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "assets/",
    "scripts/",
    "skills/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint client index.client.tsx",
    "test": "node --test tests/*.test.mjs",
    "test:settings": "node tests/settings-interaction.check.cjs",
    "test:ui": "node tests/dropdown-interaction.check.cjs && node tests/filter-dropdown-interaction.check.cjs && node tests/status-dropdown-interaction.check.cjs && node tests/dialog-interaction.check.cjs && node tests/hierarchy-interaction.check.cjs && node tests/label-display-interaction.check.cjs",
    "sdk:main": "node scripts/use-main-sdk.mjs",
    "test:workflow": "node tests/workflow-interaction.check.cjs",
    "test:basic": "node tests/client-entry.check.cjs && node tests/iteration-interaction.check.cjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.14.0-beta.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "zod": "4.4.3"
  },
  "description": "Paseo TAPD workbench with full details, direct tools and approved Agent dispatch",
  "license": "MIT"
}
